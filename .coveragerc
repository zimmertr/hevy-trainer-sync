[run]
branch = True
# The release pipeline's two scripts are held to the same bar as the package:
# one decides the version that ships, the other the tag production runs.
source =
    src/hevy_trainer_sync
    .github/scripts

[report]
# No floor: the aim is 100%, and a gap gets a test or a written reason
# (record 0032).
show_missing = True
skip_covered = True
